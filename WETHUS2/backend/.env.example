PORT=8787
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
JWT_SECRET=replace_with_long_random_secret
TOKEN_ENCRYPTION_KEY=replace_with_another_long_random_secret_32_chars_min
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://your-vercel-domain.vercel.app
ADMIN_EMAIL=admin@wethus.ai
ADMIN_BOOTSTRAP_PASSWORD=replace_with_strong_temp_password
WETHUS_DATA_DIR=

# Optional production hardening flags
CLOUD_STATE_REQUIRE_SESSION=false
INTEGRATIONS_REQUIRE_ACTOR=false
INTEGRATIONS_REQUIRE_SESSION=false
INTEGRATIONS_ENFORCE_LAUNCH_SCOPE=false
PROJECT_INTERACTIONS_REQUIRE_SESSION=false
PROJECT_ACCESS_REQUIRE_MEMBERSHIP=false
DM_REQUIRE_SESSION=false

# Optional: prelaunch signup email notification
# Prefer Resend on Render free services because outbound SMTP ports can be blocked.
RESEND_API_KEY=
RESEND_FROM=WETHUS <onboarding@resend.dev>
PRELAUNCH_NOTIFY_EMAIL=
# SMTP is kept as a fallback for paid hosts or local environments.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: server-side AI summarize (recommended for stability)
# Use `AI_PROVIDER=ollama` for a local LLM backend.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=10m
# Production defaults to true when this value is omitted.
AI_MEMORY_REQUIRE_SESSION=false
INTEGRATION_APP_URL=https://wethus-api.onrender.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
